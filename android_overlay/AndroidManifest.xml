<?xml version="1.0" encoding="utf-8"?>
<!--
    Финальный манифест лаунчера. Заменяет сгенерированный flutter create.

    sharedUserId="android.uid.system" + подпись платформенным ключом
    прошивки (в CI — публичным тестовым ключом AOSP) делают лаунчер
    СИСТЕМНЫМ приложением. Это нужно для встраивания живых окон чужих
    приложений (ActivityView), как в CarCar. Работает только на
    прошивках, которые доверяют этому ключу (многие китайские магнитолы;
    у пользователя CarCar так и запускается). На обычном телефоне/
    эмуляторе такой APK либо не установится, либо не получит системных
    прав — тогда лаунчер сам откатывается на свободные окна.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="Deprecated">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Погода в пилюле: запрос к Open-Meteo и последнее местоположение. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Запуск activity чужих приложений на виртуальных дисплеях окон.
         Это системные/signature-разрешения — реально выдаются только
         системному (платформенно подписанному) приложению. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACTIVITY_EMBEDDING"
        tools:ignore="ProtectedPermissions" />
    <!-- Привязка виджетов рабочего стола без диалога подтверждения —
         доступна системному приложению. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="Car Launcher"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="false">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Обычный запуск (из списка приложений / при сборке). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Регистрация как "домашний экран" (HOME).
                 Именно это заставляет Android открывать приложение
                 после загрузки устройства и по кнопке "Домой" —
                 без каких-либо дополнительных разрешений. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Опционально: переприменяет параметры киоск-режима после
             перезагрузки, если приложение зарегистрировано как Device Owner.
             Ничего не делает и не требует прав для обычного (не-owner)
             режима работы. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin / Device Owner receiver — используется только
             если вы осознанно включаете киоск-режим (README, раздел
             "Device Owner"). Для обычной работы лаунчера не обязателен. -->
        <receiver
            android:name=".DeviceOwnerReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Начиная с Android 11 (API 30) видимость других пакетов ограничена.
         Это нужно, если решите реально запускать установленные приложения
         из пресетов (PackageManager.getLaunchIntentForPackage). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
